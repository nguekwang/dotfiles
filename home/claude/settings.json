{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "fallbackModel": ["sonnet", "haiku"],

  "modelSettings": {
    "claude-opus-5-5": { "effortLevel": "high" },
    "claude-sonnet-5-5": { "effortLevel": "high" },
    "claude-haiku-5-5": { "effortLevel": "medium" }
  },

  "modelPicker": {
    "options": [
      { "model": "opus", "label": "Opus", "description": "Main work, design, hard bugs" },
      { "model": "sonnet", "label": "Sonnet", "description": "Lighter implementation, saving usage" },
      { "model": "haiku", "label": "Haiku", "description": "Lookups and simple tasks" }
    ],
    "replaceBuiltInOptions": true
  },

  "language": "english",
  "showThinkingSummaries": true,
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(npm run lint)",
      "Bash(npm run test *)",
      "Bash(sudo pacman *)",
      "Bash(pm *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(npm publish *)",
      "Bash(dangerouslyDisableSandbox:true)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.gnupg/**)"
    ]
  },
  "autoMode": {
    "classifyAllShell": true,
    "soft_deny": [
      "$defaults",
      "Never delete files outside the current repository"
    ]
  },
  "useAutoModeDuringPlan": true,
  "skipAutoPermissionPrompt": true,
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "filesystem": {
      "denyRead": ["~/.gnupg", "~/.config/gcloud"]
    },
    "credentials": {
      "files": [
        { "path": "~/.ssh", "mode": "deny" },
        { "path": "~/.aws", "mode": "deny" },
        { "path": "~/.netrc", "mode": "deny" },
        { "path": "~/.docker/config.json", "mode": "deny" }
      ],
      "envVars": [
        { "name": "GITHUB_TOKEN", "mode": "deny" },
        { "name": "GH_TOKEN", "mode": "deny" },
        { "name": "NPM_TOKEN", "mode": "deny" },
        { "name": "ANTHROPIC_API_KEY", "mode": "deny" },
        { "name": "OPENAI_API_KEY", "mode": "deny" },
        { "name": "AWS_SECRET_ACCESS_KEY", "mode": "deny" }
      ]
    },
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "github.com",
        "codeload.github.com",
        "objects.githubusercontent.com"
      ]
    }
  },
  "anchorSoFar": true,
  "voice": {
    "enabled": true,
    "mode": "tap"
  },
  "theme": "auto",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true
}