    ]
  },
  "useAutoModeDuringPlan": true,
  "skipAutoPermissionPrompt": true,
  "anchorSoFar": true,
  "permissions": {
    "allow": [
      "Bash(sudo pacman *)",
      "Bash(pm *)"
    ],
    "deny": [],
    "defaultMode": "auto"
  },
  "voice": {
    "enabled": true,
    "mode": "tap"
  },
  "theme": "auto",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true
}
