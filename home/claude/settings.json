{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "fallbackModel": ["sonnet", "haiku"],

  "modelSettings": {
    "claude-opus-5-5": { "effortLevel": "high" },
    "claude-sonnet-5-5": { "effortLevel": "high" },
    "claude-haiku-5-5": { "effortLevel": "medium" }
  },

  "modelPicker": {
    "options": [
      { "model": "opus", "label": "Opus", "description": "Main work, design, hard bugs" },
      { "model": "sonnet", "label": "Sonnet", "description": "Lighter implementation, saving usage" },
      { "model": "haiku", "label": "Haiku", "description": "Lookups and simple tasks" }
    ],
    "replaceBuiltInOptions": true
  },

  "language": "english",
  "showThinkingSummaries": true,
{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(npm run lint)",
      "Bash(npm run test *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(npm publish *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)"
    ]
  },
  "autoMode": {
    "classifyAllShell": true,
    "soft_deny": [
      "$defaults",
      "Never delete files outside the current repository"
    ]
  },
  "useAutoModeDuringPlan": true,
  "skipAutoPermissionPrompt": true,
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
