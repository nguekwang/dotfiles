#!/bin/sh
set -e
. "$(dirname "$0")/run"
path_config="${XDG_CONFIG_HOME:-$path_home/.config}"
path_etc="/etc"
path_rows="$path_dot/sh/link-list"

link() (
    path_target="$path_dot/$2"
    path_link="$3"
    [ -e "$path_target" ] || [ -L "$path_target" ] || {
        printf 'error: link: source "%s" does not exist\n' "$2" >&2
        return 1
    }
    if [ -d "$path_link" ] && [ ! -L "$path_link" ]; then
        run "$1" rm -rf "$path_link"
    fi
    run "$1" mkdir -p "$(dirname "$path_link")"
    run "$1" ln -sfn "$path_target" "$path_link"
)

while read -r enum_mode path_src enum_root path_rel; do
    case "$enum_root" in
        etc) path_base="$path_etc" ;;
        config) path_base="$path_config" ;;
        home) path_base="$path_home" ;;
    esac
    link "$enum_mode" "$path_src" "$path_base/$path_rel"
done < "$path_rows"
