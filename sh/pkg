#!/bin/sh
set -e
. "$(dirname "$0")/run"
path_rows="$path_dot/sh/pkg-list"
path_aur="https://aur.archlinux.org/paru.git"
list_pacman=""
list_aur=""

while read -r enum_source name_pkg; do
    case "$enum_source" in
        pacman) list_pacman="$list_pacman $name_pkg" ;;
        aur) list_aur="$list_aur $name_pkg" ;;
    esac
done < "$path_rows"

list_old="$(pacman -Q)"

report() {
    list_new="$(pacman -Q)"
    printf '%s\n' "$list_new" | grep -vxF "$list_old" | sed 's/^/info: pkg: installed /' >&2
    list_old="$list_new"
    printf 'info: pkg: %s\n' "$1" >&2
}

run sudo pacman -Syu --needed --noconfirm $list_pacman >/dev/null
report "packages installed"

if command -v paru >/dev/null; then
    run user paru -Sua --noconfirm >/dev/null
else
    path_work="$(run user mktemp -d -t pkg.XXXXXX)"
    trap 'rm -rf "$path_work"' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'exit 129' HUP
    run user git clone -q "$path_aur" "$path_work/paru"
    run user bash -c '. /etc/makepkg.conf
for path_dest in "${PKGDEST:-}" "${SRCDEST:-}" "${LOGDEST:-}" "${BUILDDIR:-}"; do
    [ -z "$path_dest" ] || mkdir -p "$path_dest"
done'
    (cd "$path_work/paru" && run user makepkg -si --noconfirm >/dev/null)
    report "paru installed"
fi

run user paru -S --needed --noconfirm $list_aur >/dev/null
report "aur packages installed"
